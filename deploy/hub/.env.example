# Copy to .env after preparing secrets with ../configure.py. Never put tokens here.
# The quickstart pulls published multiarchitecture images. main is a moving development tag.
# For production, pin BOTH images to the same published sha-<full-commit> tag or their digests.
# ROBOTOS_IMAGE=ghcr.io/windoze95/robotos-hub:sha-<full-commit>
# ROBOTOS_HERMES_IMAGE=ghcr.io/windoze95/robotos-hermes:sha-<full-commit>
# For local development builds, set these to robotos-hub:local and robotos-hermes:local.
ROBOTOS_PUBLIC_ORIGIN=https://workspace.example.net
HERMES_API_URL=https://hermes.example.net
ROBOTOS_SECRET_DIR=./private
ROBOTOS_LOCAL_PORT=8787
HERMES_LOCAL_PORT=8642
# Optional transcription endpoint. Empty disables host transcription.
SPEECH_API_URL=
SPEECH_MODEL=gpt-4o-mini-transcribe
