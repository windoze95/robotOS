<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black glass, warm white type and the R1's high-vis orange. Orange marks what is live or
         primary; errors use a distinct rose so they never read as the accent. -->
    <color name="bg">#000000</color>
    <!-- Cards, rows and fields. -->
    <color name="field">#151515</color>
    <!-- Icon wells, chips and secondary buttons. -->
    <color name="raised">#242424</color>
    <color name="outline">#2E2E2E</color>
    <color name="fg">#F6F4F0</color>
    <color name="dim">#A3A09A</color>
    <color name="faint">#6C6A65</color>
    <color name="accent">#FF4F12</color>
    <color name="on_accent">#0A0A0A</color>
    <!-- The host console's orange-soft: the fill inside the robotOS mark. -->
    <color name="accent_soft">#2B1C15</color>
    <color name="press">#4DFF4F12</color>
    <color name="error">#FF5C7A</color>
    <color name="ok">#4BE38A</color>
</resources>
