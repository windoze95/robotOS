<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <!-- Chat title (opens Chats), radio and battery status (opens Quick controls), and the menu. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:paddingStart="6dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="2dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_vertical">
                <TextView android:id="@+id/chat_title" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
                    android:text="New chat" android:textSize="19sp" android:fontFamily="@font/display" android:textFontWeight="700"
                    android:textColor="@color/fg" android:maxLines="1" android:ellipsize="end"
                    android:drawableEnd="@drawable/ic_chevron_down" android:drawableTint="@color/dim" android:drawablePadding="2dp"
                    android:background="@drawable/press_round" android:clickable="true" android:focusable="true"
                    android:contentDescription="Open saved chats" />
            </LinearLayout>
            <TextView android:id="@+id/controls" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="6dp" android:minWidth="58dp" android:gravity="center"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:drawablePadding="5dp"
                android:background="@drawable/pill_raised"
                android:clickable="true" android:focusable="true" android:contentDescription="Quick controls" />
            <ImageButton android:id="@+id/menu" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp"
                android:src="@drawable/ic_menu" android:tint="@color/fg" android:background="@drawable/circle_raised"
                android:contentDescription="Menu" />
        </LinearLayout>

        <TextView android:id="@+id/hermes_task" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="6dp"
            android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="12dp"
            android:paddingTop="9dp" android:paddingBottom="9dp" android:drawablePadding="12dp"
            android:textSize="16sp" android:fontFamily="@font/display" android:textFontWeight="500" android:textColor="@color/fg"
            android:clickable="true" android:focusable="true" android:visibility="gone" android:maxLines="3" android:ellipsize="end" />
        <TextView android:id="@+id/hermes_notice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="6dp"
            android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="12dp"
            android:paddingTop="9dp" android:paddingBottom="9dp" android:drawablePadding="12dp"
            android:textSize="15sp" android:textColor="@color/fg"
            android:clickable="true" android:focusable="true" android:visibility="gone" android:maxLines="3" android:ellipsize="end" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
                android:fillViewport="true" android:scrollbars="vertical" android:scrollbarSize="3dp"
                android:requiresFadingEdge="vertical" android:fadingEdgeLength="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="10dp" android:clipToPadding="false">

                    <!-- First run and empty chats: what the button does, pointed at the button. -->
                    <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="8dp" android:clipChildren="false">
                        <TextView android:id="@+id/empty_kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:drawablePadding="8dp" android:text="Hermes" android:textAllCaps="true" android:letterSpacing="0.1"
                            android:textSize="12sp" android:fontFamily="@font/mono" android:textFontWeight="800" android:textColor="@color/accent" />
                        <TextView android:id="@+id/empty_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="Hold the button"
                            android:textSize="30sp" android:fontFamily="@font/display" android:textFontWeight="700" android:textColor="@color/fg"
                            android:letterSpacing="-0.02" android:lineSpacingMultiplier="0.92" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                            android:clipChildren="false">
                            <TextView android:id="@+id/empty_title_end" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="to talk." android:textSize="30sp" android:fontFamily="@font/display" android:textFontWeight="700"
                                android:textColor="@color/accent" android:letterSpacing="-0.02" />
                            <dev.r1ptt.ui.EdgeArrow android:id="@+id/empty_arrow" android:layout_width="0dp" android:layout_height="24dp"
                                android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="-14dp"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                        <TextView android:id="@+id/empty_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="Release to send it to Hermes."
                            android:textSize="16sp" android:textColor="@color/dim" android:lineSpacingExtra="2dp" />
                        <LinearLayout android:id="@+id/empty_legend" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" android:orientation="vertical" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

                    <!-- The exchange in progress: Hermes working, then the reply as it streams. -->
                    <LinearLayout android:id="@+id/live_box" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="6dp" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:id="@+id/live_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:drawablePadding="6dp" android:text="Hermes" android:textAllCaps="true" android:letterSpacing="0.1"
                                android:textSize="11sp" android:fontFamily="@font/mono" android:textFontWeight="800" android:textColor="@color/accent" />
                            <dev.r1ptt.ui.PulseView android:id="@+id/live_pulse" android:layout_width="26dp" android:layout_height="8dp"
                                android:layout_marginStart="10dp" />
                            <TextView android:id="@+id/live_note" android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end"
                                android:textSize="11sp" android:fontFamily="@font/mono" android:textFontWeight="500" android:textColor="@color/dim" />
                        </LinearLayout>
                        <TextView android:id="@+id/live" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:paddingTop="6dp" android:textSize="17sp" android:textColor="@color/fg" android:lineSpacingExtra="3dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <ImageButton android:id="@+id/latest" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="bottom|end" android:layout_margin="12dp" android:src="@drawable/ic_arrow_down"
                android:tint="@color/on_accent" android:background="@drawable/circle_accent" android:elevation="6dp"
                android:contentDescription="Latest" android:visibility="gone" />
        </FrameLayout>

        <!-- One line about what the R1 is doing right now: dictation, speech, errors, setup. -->
        <LinearLayout android:id="@+id/turn_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="34dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="16dp"
            android:background="@drawable/press_round">
            <dev.r1ptt.ui.PulseView android:id="@+id/pulse" android:layout_width="22dp" android:layout_height="14dp"
                android:layout_marginEnd="10dp" android:visibility="gone" />
            <dev.r1ptt.ui.LevelBars android:id="@+id/dictation_meter" android:layout_width="44dp" android:layout_height="18dp"
                android:layout_marginEnd="10dp" android:visibility="gone" />
            <ImageView android:id="@+id/status_icon" android:layout_width="18dp" android:layout_height="18dp"
                android:layout_marginEnd="10dp" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingTop="6dp" android:paddingBottom="6dp" android:textColor="@color/dim" android:textSize="14sp"
                android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <LinearLayout android:id="@+id/composer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="bottom" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="12dp">
            <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="52dp" android:background="@drawable/field" android:hint="Message Hermes"
                android:contentDescription="Message to Hermes" android:imeOptions="actionSend" android:importantForAutofill="no"
                android:inputType="textCapSentences|textAutoCorrect" android:paddingStart="18dp" android:paddingEnd="14dp"
                android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center_vertical"
                android:textColor="@color/fg" android:textColorHint="@color/dim" android:textSize="17sp" />
            <TextView android:id="@+id/send" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="8dp"
                android:minWidth="52dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/circle_accent" android:drawableStart="@drawable/ic_send" android:drawableTint="@color/on_accent"
                android:textSize="17sp" android:fontFamily="@font/display" android:textFontWeight="700" android:textColor="@color/on_accent"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/send" />
            <ImageButton android:id="@+id/type" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp"
                android:src="@drawable/ic_keyboard" android:tint="@color/fg" android:background="@drawable/circle_raised"
                android:contentDescription="Type a message" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <dev.r1ptt.ui.VoiceStage android:id="@+id/stage" android:layout_width="match_parent" android:layout_height="match_parent" />

    <FrameLayout android:id="@+id/menu_sheet" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/bg" android:clickable="true" android:focusable="true" android:visibility="gone" />
</FrameLayout>
