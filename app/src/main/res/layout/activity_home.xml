<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="8dp"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/chat_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical"
            android:text="New chat" android:textSize="20sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/fg" android:maxLines="1" android:ellipsize="end" android:clickable="true" android:focusable="true"
            android:contentDescription="Open saved chats" />
        <TextView android:id="@+id/controls" android:layout_width="64dp" android:layout_height="48dp"
            android:gravity="center" android:text="Controls" android:textSize="13sp" android:textColor="@color/dim"
            android:clickable="true" android:focusable="true" android:contentDescription="Quick controls" />
        <TextView android:id="@+id/menu" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="⋮" android:textSize="26sp" android:textColor="@color/fg"
            android:clickable="true" android:focusable="true" android:contentDescription="Menu" />
    </LinearLayout>
    <LinearLayout android:id="@+id/turn_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="6dp" android:textColor="@color/dim" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/stop" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="64dp"
            android:gravity="center" android:text="Stop" android:textColor="@color/accent" android:textSize="15sp"
            android:clickable="true" android:focusable="true" android:visibility="gone" />
    </LinearLayout>
    <ProgressBar android:id="@+id/meter" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:max="100"
        android:progressTint="@color/accent" android:visibility="invisible" />
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="48dp" android:paddingBottom="32dp" android:text="Hold the side button.\nSpeak, then release."
                android:textColor="@color/fg" android:textSize="24sp" android:lineSpacingExtra="5dp" />
            <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/live" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingVertical="12dp" android:textSize="17sp" android:textColor="@color/fg" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/latest" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center" android:text="Latest" android:textSize="15sp" android:textColor="@color/accent"
        android:clickable="true" android:focusable="true" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:background="@drawable/field" android:hint="Type to Hermes"
            android:contentDescription="Message to Hermes" android:imeOptions="actionSend" android:importantForAutofill="no"
            android:inputType="textCapSentences|textAutoCorrect" android:paddingHorizontal="12dp" android:paddingVertical="8dp"
            android:textColor="@color/fg" android:textColorHint="@color/dim" android:textSize="16sp" />
        <ImageButton android:id="@+id/send" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
            android:background="@drawable/field" android:contentDescription="@string/send" android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
